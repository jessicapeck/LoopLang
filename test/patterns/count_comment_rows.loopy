let seq1 = sc 20 << comment attached to sc 20 in row 4 >>
let seq2 = dc 20 << comment attached to dc 20 in rows 9 to 10 >>
let seq3 = sc 20 << comment attached to sc 20 in row 14 >>
let n = 11

R1: ch 20
R2: sc 20 [20] << comment at end of row 2 >>
R3: dc 20 [20]
R4: seq1 << comment at end of row 4 >>
R5-6: dc 20 [20] << comment at end of rows 5 to 6 >>
R7-8: sc 20 [20]
R9-10: seq2 << comment at end of rows 9 to 10 >>
R(n): dc 20
R(n+1): sc 20 [20] << comment at end of row 12 >>
R(n+2): dc 20 [20]
R(n+3): seq3 << comment at the end of row 14 >>