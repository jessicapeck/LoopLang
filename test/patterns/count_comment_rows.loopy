let seq1 = sc 20 << comment attached to sc 20 >>
let seq2 = dc 20 << comment attached to dc 20 >>

R1: ch 20
R2: sc 20 [20] << comment at end of row 2 >>
R3: dc 20 [20]
R4: seq1 << comment at end of row 4 >>
R5-6: dc 20 [20] << comment at end of rows 5 to 6 >>
R7-8: sc 20 [20]
R9-10: seq2 << comment at end of rows 9 to 10 >>